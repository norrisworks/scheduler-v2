VITE_SUPABASE_URL=https://solflnjhncpanwlomvjp.supabase.co
VITE_SUPABASE_ANON_KEY=

# Only for `npm run check:db`, never for the app — the two above are the only
# ones the browser bundle reads. db_schema_facts is admin-gated, so the checks
# need one of these; without them check:db exits 1 and says so.
#
# Preferred (Supabase dashboard -> Settings -> API -> service_role). It bypasses
# RLS entirely, so it belongs in .env.local (gitignored) and nowhere else.
# SUPABASE_SERVICE_ROLE_KEY=
#
# Or sign in as an admin account instead, using the anon key above.
# SCHEDULER_ADMIN_EMAIL=
# SCHEDULER_ADMIN_PASSWORD=
